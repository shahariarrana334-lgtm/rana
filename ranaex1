    <h2>Sum of Multiples of 3 or 5 Below 1000</h2>

    <script>
        let sum = 0;

        for (let i = 1; i < 1000; i++) {
            if (i % 3 === 0 || i % 5 === 0) {
                sum = sum + i;
            }
        }
