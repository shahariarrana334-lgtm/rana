<!DOCTYPE html>
<html>
<head>
    <title>Multiples of 3 or 5</title>
</head>

<body>

    <h1>Sum of Multiples of 3 or 5</h1>

    <p>
        Find the sum of all natural numbers below 1000
        that are multiples of 3 or 5.
    </p>

    <script>
        let sum = 0;

        for (let i = 1; i < 1000; i++) {
            if (i % 3 === 0 || i % 5 === 0) {
                sum = sum + i;
            }
        }

        alert("The sum of all multiples of 3 or 5 below 1000 is: " + sum);
    </script>

</body>
</html>
